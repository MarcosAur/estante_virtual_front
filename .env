# URL base para as requisições da API
# Em desenvolvimento com proxy do Vite (padrão), mantenha '/api/v1'
# Para apontar diretamente para uma API externa ou remota sem proxy, informe a URL completa (ex: 'http://127.0.0.1:8000/api/v1')
VITE_API_URL=/api/v1

# Endereço do backend para o proxy do Vite no modo desenvolvimento (npm run dev)
VITE_BACKEND_URL=http://127.0.0.1:8000

# Ativar (true) ou desativar (false) novos cadastros de usuários no sistema
VITE_ENABLE_REGISTER=true
